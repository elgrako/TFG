<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp"
    android:background="#000000">

    <Button
        android:id="@+id/irRecursoGuardiaButton"
        android:layout_width="193dp"
        android:layout_height="65dp"
        android:layout_marginTop="88dp"
        android:backgroundTint="#0A5D93"
        android:text="@string/irRecurso"
        android:textColor="#FFFFFF"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/nExpedienteApelacionField" />

    <Switch
        android:id="@+id/switchAdmitidoApelacion"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="88dp"
        android:text="@string/switchAdmitidoApelacion"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:thumbTint="#3498DB"
        android:trackTint="#555555"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:ignore="UseSwitchCompatOrMaterialXml" />

    <EditText
        android:id="@+id/nExpedienteApelacionField"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_marginTop="52dp"
        android:autofillHints=""
        android:background="@drawable/edittext_background"
        android:hint="@string/nExpedienteApelacion"
        android:inputType="text"
        android:padding="12dp"
        android:textColor="#FFFFFF"
        android:textColorHint="#AAAAAA"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/switchSentenciaApelacion" />

    <Switch
        android:id="@+id/switchSentenciaApelacion"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:text="@string/switchSentenciaApelacion"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:thumbTint="#3498DB"
        android:trackTint="#555555"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/switchPresentadoApelacion"
        tools:ignore="UseSwitchCompatOrMaterialXml" />

    <Switch
        android:id="@+id/switchPresentadoApelacion"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:text="@string/switchPresentadoApelacion"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:thumbTint="#3498DB"
        android:trackTint="#555555"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/switchAdmitidoApelacion"
        tools:ignore="UseSwitchCompatOrMaterialXml" />

    <Button
        android:id="@+id/guardarApelacionGuardiaButton"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_marginStart="8dp"
        android:layout_marginTop="116dp"
        android:backgroundTint="#3498DB"
        android:text="@string/guardarApelacionbtn"
        android:textColor="#FFFFFF"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/cancelarApelacionGuardiaButton"
        app:layout_constraintTop_toBottomOf="@+id/irRecursoGuardiaButton" />

    <Button
        android:id="@+id/cancelarApelacionGuardiaButton"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_marginTop="116dp"
        android:layout_marginEnd="8dp"
        android:backgroundTint="#555555"
        android:text="@string/CancelarApelacionbtn"
        android:textColor="#FFFFFF"
        app:layout_constraintEnd_toStartOf="@id/guardarApelacionGuardiaButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/irRecursoGuardiaButton" />

</androidx.constraintlayout.widget.ConstraintLayout>
