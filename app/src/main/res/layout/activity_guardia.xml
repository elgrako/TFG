<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    android:padding="24dp"
    tools:context=".GuardiaActivity">

    <TextView
        android:id="@+id/diaActuacionField"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_marginTop="64dp"
        android:backgroundTint="@color/colorPrimary"
        android:background="@android:drawable/editbox_background_normal"
        android:hint="@string/diaActuacion"
        android:textColor="@color/colorTextPrimary"
        android:textSize="16sp"
        android:gravity="center_vertical"
        android:padding="12dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <EditText
        android:id="@+id/nombreAsistidoField"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_marginTop="20dp"
        android:hint="@string/nombreAsistido"
        android:inputType="textPersonName"
        android:textColor="@color/colorTextPrimary"
        android:textColorHint="@color/colorTextSecondary"
        android:backgroundTint="@color/colorPrimary"
        android:padding="12dp"
        app:layout_constraintTop_toBottomOf="@id/diaActuacionField"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Switch
        android:id="@+id/switchporJuzgado"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:layout_marginTop="24dp"
        android:text="@string/porJuzgado"
        android:textColor="@color/colorTextSecondary"
        android:textSize="18sp"
        android:textStyle="bold"
        android:paddingStart="8dp"
        app:layout_constraintTop_toBottomOf="@id/nombreAsistidoField"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:ignore="UseSwitchCompatOrMaterialXml" />

    <Switch
        android:id="@+id/switchcobrado"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:layout_marginTop="12dp"
        android:text="@string/cobradoGuardia"
        android:textColor="@color/colorTextSecondary"
        android:textSize="18sp"
        android:textStyle="bold"
        android:paddingStart="8dp"
        app:layout_constraintTop_toBottomOf="@id/switchporJuzgado"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:ignore="UseSwitchCompatOrMaterialXml" />

    <Button
        android:id="@+id/guardarGuardiaButton"
        android:layout_width="0dp"
        android:layout_height="52dp"
        android:layout_marginTop="124dp"
        android:backgroundTint="@color/colorPrimary"
        android:text="@string/guardarGuardiaBtn"
        android:textColor="@color/colorOnPrimary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/switchcobrado" />

</androidx.constraintlayout.widget.ConstraintLayout>
